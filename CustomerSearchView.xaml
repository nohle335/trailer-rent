<UserControl x:Class="Trailer_Rental.CustomerSearchView"

             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 

             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 

             xmlns:local="clr-namespace:Trailer_Rental"

             mc:Ignorable="d" 

             d:DesignHeight="1080" d:DesignWidth="1920"

             Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bereich -->
            <RowDefinition Height="120"/>
            <!-- Titel-Badge "Customer Search" -->
            <RowDefinition Height="60"/>
            <!-- Filter & Suche & Sortierung -->
            <RowDefinition Height="Auto"/>
            <!-- Haupttabelle / DataGrid -->
            <RowDefinition Height="*"/>
            <!-- Footer Navigation -->
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Grid Grid.Row="0" Margin="40,20,40,0">
            <!-- Icon oben links -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <UniformGrid Rows="3" Columns="3" Width="90" Height="60">
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FFC480" CornerRadius="6" Margin="2"/>
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FFC480" CornerRadius="6" Margin="2"/>
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FF8000" CornerRadius="6" Margin="2"/>
                    <Border Background="#FFE4CC" CornerRadius="6" Margin="2"/>
                </UniformGrid>
            </StackPanel>

            <!-- Haupttitel "Trailer Rental" -->
            <TextBlock Text="Trailer Rental" 

                       FontSize="64" 

                       FontWeight="Bold" 

                       Foreground="#FF9138" 

                       HorizontalAlignment="Center" 

                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ================= TITEL BADGE ================= -->
        <Border Grid.Row="1" 

                Background="#B5B5B5" 

                Width="400" 

                Height="50" 

                HorizontalAlignment="Center" 

                VerticalAlignment="Top">
            <TextBlock Text="Customer Search" 

                       FontSize="26" 

                       FontWeight="Bold" 

                       Foreground="Black" 

                       HorizontalAlignment="Center" 

                       VerticalAlignment="Center"/>
        </Border>

        <!-- ================= FILTER & SEARCH BAR ================= -->
        <Grid Grid.Row="2" Margin="40,10,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Linker Filter-Block -->
            <Border Grid.Column="0" Background="#CCCCCC" Grid.ColumnSpan="3" Margin="44,0,1156,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45"/>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="35"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Trichter Symbol -->
                        <Path Data="M 0,0 L 16,0 L 10,8 L 10,14 L 6,16 L 6,8 Z" Fill="#333333" Stretch="Uniform" Width="18" Height="18" Margin="0,0,10,0"/>
                        <TextBlock Text="Kundendatenfilter" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Row="1" Content="Passenger Car Trailer" Background="#7A7A7A" Foreground="White" BorderThickness="0" Margin="30,2,0,2" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                    <Button Grid.Row="2" Content="Horse Trailer" Background="#7A7A7A" Foreground="White" BorderThickness="0" Margin="30,2,0,2" HorizontalContentAlignment="Left" Padding="10,0,0,0"/>
                </Grid>
            </Border>

            <!-- Mittleres Suchfeld -->
            <Grid Grid.Column="2" VerticalAlignment="Top" Height="45">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>

                <TextBox Text="Suchbegriff eingeben ..." 

                         FontSize="18" 

                         VerticalContentAlignment="Center" 

                         Padding="15,0,0,0" 

                         Background="#CCCCCC" 

                         Foreground="#555555" 

                         BorderThickness="0" Margin="42,0,0,0"/>

                <Button Grid.Column="1" Background="#8A8A8A" BorderThickness="0">
                    <!-- Lupe Symbol -->
                    <Path Data="M 0,7 A 7,7 0 1,0 14,7 A 7,7 0 1,0 0,7 M 12,12 L 18,18" 

                          Stroke="Black" 

                          StrokeThickness="3" 

                          Width="20" Height="20" 

                          Stretch="Uniform"/>
                </Button>
            </Grid>

            <!-- Rechter Sortierungs-Block -->
            <Border Grid.Column="4" Background="#CCCCCC">
                <StackPanel>
                    <TextBlock Text="Anzeigeanordnung" FontSize="16" Margin="10,8,0,8"/>

                    <Grid Height="30" Background="#7A7A7A" Margin="0,1,0,1">
                        <TextBlock Text="Alphabetisch" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
                            <Button Content="↓" Width="22" Margin="2" Background="#999" BorderThickness="0"/>
                            <Button Content="↑" Width="22" Margin="2" Background="#999" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Height="30" Background="#7A7A7A" Margin="0,1,0,1">
                        <TextBlock Text="Numerisch" Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,5,0">
                            <Button Content="↓" Width="22" Margin="2" Background="#999" BorderThickness="0"/>
                            <Button Content="↑" Width="22" Margin="2" Background="#999" BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= DATEN TABELLE (DATAGRID) ================= -->
        <DataGrid Grid.Row="3" 

                  Margin="82,0,40,20" 

                  AutoGenerateColumns="False" 

                  Background="#CCCCCC" 

                  RowBackground="#B5B5B5" 

                  AlternatingRowBackground="#CCCCCC"

                  GridLinesVisibility="All" 

                  HorizontalGridLinesBrush="White" 

                  VerticalGridLinesBrush="White"

                  HeadersVisibility="Column"

                  BorderThickness="0"

                  RowHeight="45">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#B5B5B5"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Height" Value="45"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Alter" Binding="{Binding Age}" Width="1*"/>
                <DataGridTextColumn Header="Ausgeliehene Anhänger" Binding="{Binding RentedTrailers}" Width="3*"/>
                <DataGridTextColumn Header="TR-Score" Binding="{Binding TrScore}" Width="1.2*"/>
                <DataGridTextColumn Header="INCBN-No." Binding="{Binding IncbnNo}" Width="1.5*"/>
                <DataGridTextColumn Header="Geburtsdatum" Binding="{Binding BirthDate}" Width="1.8*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= FOOTER ================= -->
        <Border Grid.Row="4" Background="#FFDEC0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Margin="20,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF8000" Width="24" Height="14" CornerRadius="7" Margin="0,0,8,0"/>
                        <TextBlock Text="Help" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="20,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FF8000" Width="24" Height="14" CornerRadius="7" Margin="0,0,8,0"/>
                        <TextBlock Text="About us" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="20,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFC480" Width="24" Height="14" CornerRadius="7" Margin="0,0,8,0"/>
                        <TextBlock Text="General Terms and Conditions" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Margin="20,0" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="#FFE4CC" Width="24" Height="14" CornerRadius="7" Margin="0,0,8,0"/>
                        <TextBlock Text="Privacy Policy" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <Button x:Name="LeasingAgreementViewButtonBackToStartView"
        Content="←"
        Click="LeasingAgreementViewButtonBackToStartView_Click"
        Grid.Row="3"
        Grid.Column="0"
        Width="50"
        Height="50"
        FontSize="30"
        FontWeight="Bold"
        Background="#F66C09"
        Foreground="White"
        Margin="10,190,0,445" HorizontalAlignment="Left" VerticalAlignment="Top"/>

    </Grid>
</UserControl>
 